# Copy this file to `.dev.vars` for local development (`.dev.vars` is gitignored).
# In PRODUCTION, set the secrets with Wrangler (they are stored on Cloudflare,
# never in the repo):
#   wrangler secret put APP_SECRET
#   wrangler secret put SHOPIFY_API_SECRET
#
# Non-secret config (SHOPIFY_API_KEY, SHOPIFY_SCOPES, APP_URL, PWA_URL) lives in
# wrangler.jsonc `vars` — override for local dev below if needed.

APP_SECRET=change-me-to-a-long-random-string
SHOPIFY_API_SECRET=your-shopify-app-secret
SHOPIFY_API_KEY=your-shopify-app-client-id
APP_URL=http://localhost:8787
PWA_URL=http://localhost:5173
