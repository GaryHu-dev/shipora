{
  "name": "stockproof-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && wrangler dev dist/index.mjs --no-bundle",
    "deploy": "node build.mjs && wrangler deploy dist/index.mjs --no-bundle",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply stockproof --local",
    "migrate:remote": "wrangler d1 migrations apply stockproof --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "qrcode-generator": "^1.5.2",
    "unpdf": "^1.8.0"
  }
}
