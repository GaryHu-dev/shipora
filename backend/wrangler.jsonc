{
  "name": "stockproof-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Points at the NEW company account's database (created 2026-08-13, region OC).
  // The old personal account's was 024e8d8c-e14a-42fd-9b36-805efaf91a88 — kept
  // here only as a breadcrumb until the migration is signed off, then delete
  // this comment. wrangler resolves by id, never by name.
  "d1_databases": [
    { "binding": "DB", "database_name": "stockproof", "database_id": "e35e7534-f5e2-477c-8fad-192d304414bc", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "stockproof-photos" }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "unsafe": {
    "bindings": [
      { "name": "PHOTO_RL", "type": "ratelimit", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } }
    ]
  },
  // Committed, non-secret config only. Secrets (APP_SECRET, SHOPIFY_API_SECRET,
  // SHOPIFY_API_KEY) are NEVER here — set them with `wrangler secret put ...`
  // (production) or in `.dev.vars` (local, gitignored). See .dev.vars.example.
  //
  "vars": {
    "SHOPIFY_SCOPES": "read_orders,write_orders,read_products,write_products,read_inventory,write_inventory,read_locations",
    "APP_URL": "https://stockproof-backend.dms-259.workers.dev",
    "PWA_URL": "https://stockproof-pwa.pages.dev"
  }
}
