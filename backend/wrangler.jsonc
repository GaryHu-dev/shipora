{
  "name": "shipora-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "shipora", "database_id": "024e8d8c-e14a-42fd-9b36-805efaf91a88", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "shipora-photos" }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "unsafe": {
    "bindings": [
      { "name": "PHOTO_RL", "type": "ratelimit", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } }
    ]
  },
  // Committed, non-secret config only. Secrets (APP_SECRET, SHOPIFY_API_SECRET,
  // SHOPIFY_API_KEY) are NEVER here — set them with `wrangler secret put ...`
  // (production) or in `.dev.vars` (local, gitignored). See .dev.vars.example.
  "vars": {
    "SHOPIFY_SCOPES": "read_orders,write_orders",
    "APP_URL": "https://shipora-backend.gary-hushek.workers.dev",
    "PWA_URL": "https://shipora-pwa.pages.dev"
  }
}
